# Copy to .env and fill in. .env is gitignored.
#
# Only the key for the selected provider is needed; startup fails immediately if it is
# missing, rather than reporting healthy and 401ing every customer request.

# 8081 deliberately: the Java implementation of this system uses 8080 and both stacks are
# expected to run on one machine.
HTTP_ADDR=:8081

CHAT_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-opus-5

# CHAT_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-5

# CHAT_PROVIDER=xai
XAI_API_KEY=
# XAI_CHAT_MODEL=grok-4.6

# --- The secondary provider ----------------------------------------------------------
# Empty means no failover: if the provider above is down, this service is down.
#
# Set it to one of the other two and that provider answers when the primary fails in a
# way retrying the primary will not fix -- 429 or 5xx after the client's own retries, a
# transport failure, or a stall. It is NOT used when the customer cancels, when the
# request itself was rejected (400/401/403/404), once a token of the primary's answer has
# reached the customer, or part-way through a tool-calling turn. docs/providers.md has the
# reasoning for each.
#
# It needs its own key: the variables above are per provider, and this reads the
# fallback's own. The service refuses to start if that key is missing, or if the fallback
# is the same provider as the primary.
#
# The two providers do not write the same way. A conversation can change voice between
# turns, and answer quality is measured on the primary only.
CHAT_FALLBACK_PROVIDER=

# Gemini is deliberately absent: this implementation supports three providers, and
# documenting a variable that nothing reads is worse than not documenting it. The Java
# implementation of this system supports it, and records that choosing a model there took
# four attempts -- see docs/providers.md.

# --- Postgres -----------------------------------------------------------------------
# Deliberately not 5432: the sibling Java implementation runs its own stack on the
# default ports, and two Compose projects cannot both claim them.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=csagent
POSTGRES_USER=csagent
POSTGRES_PASSWORD=csagent

# --- Operations surface -------------------------------------------------------------
# `name:token[:role]`, comma separated. Roles are viewer (read) and operator (read and
# change tickets); omitting the role gives viewer.
#
# Unset means /admin and /api/admin/v1/* do not exist at all -- not 401, 404. This page
# shows customer conversations, which everything else in this service works to keep out
# of logs, spans and metric labels, so it exists only where somebody decided it should.
# Use generated tokens; the minimum accepted length is 16 characters.
#
#   # Who may talk to the chat endpoints.
#
#   off      no sessions, conversation ids supplied by the client, no ownership. Anyone
#            who knows an id can append to that history and have the model answer with
#            its context. It is what the benchmark and the cross-repository comparison
#            drive, and it is not a production configuration.
#   session  the service issues an opaque token at POST /api/v1/session, binds each
#            conversation to it, and answers 404 for anyone else's.
AUTH_MODE=off
SESSION_TTL_HOURS=24

# The two ceilings that stop a stranger spending the model budget. Both are shared state
# in Postgres, because a counter in a process is `replicas x limit`. Zero disables one.
#
# The per-conversation budget (CONVERSATION_TOKEN_BUDGET) cannot do this job: conversation
# ids are free, so anyone who wants more of it starts another conversation.
TURNS_PER_MINUTE=20
SESSIONS_PER_HOUR_PER_IP=60
DAILY_TOKEN_BUDGET=0

# How long customer data is kept. A conversation's turns and memory are deleted once they
# are older than this; tickets are not, because a ticket ages on its own lifecycle and an
# OPEN one is work somebody still owes a customer.
#
# Zero keeps everything for ever, and the server warns about it at start-up. Erasure on
# request (DELETE /api/admin/v1/conversations/{id}, operator only, audited) works either
# way -- this is expiry by age, not the answer to "please delete my data".
# How long a turn may be in flight before a sweeper decides the process running it died and
# marks it "unknown" -- never "failed", which is something this service observed, and never
# "completed". Must exceed HTTP_READ_TIMEOUT, or the sweeper marks live turns as abandoned;
# the server refuses to start otherwise.
TURN_LEASE=5m

RETENTION_DAYS=0
RETENTION_SWEEP_INTERVAL=1h

# Where a raised ticket is announced. Any URL that accepts a JSON POST: a chat webhook, a
# ticketing system's inbox, your own relay. Empty means a ticket is created and nobody is
# told, which the server warns about at start-up.
#
# The body carries the ticket number, the conversation id and what happened -- and no
# customer text. A webhook is by definition outside this service's control, and whoever
# receives it can open the operations UI, where reading a conversation is audited.
HANDOFF_WEBHOOK_URL=
HANDOFF_TIMEOUT=5s

# --- The order service ---------------------------------------------------------------
# Where lookup_order_status reads from.
#
# **Unset means a fixture.** Five hard-coded orders, ORD-10042 to ORD-10046, and every
# other number comes back as not found. That is the default, because the tests, the
# benchmark and the answer eval all measure the model's behaviour and a real lookup would
# put variance into every one of them -- and the server logs a warning saying so at every
# start-up, because a service answering from a fixture while everyone believes it is
# talking to the order system is indistinguishable from one that works.
#
# Set the URL and the HTTP adapter is used instead. It expects
# `GET {ORDER_SERVICE_URL}/orders/{number}` with a bearer token, 200 for an order, 404 for
# no such order. **That contract has never been run against a real order system** -- there
# is none to run it against -- so it is a starting point, not a specification. See
# docs/tools.md.
ORDER_SERVICE_URL=
ORDER_SERVICE_TOKEN=

# The budget for the *whole* lookup, retries included, because what matters is how long
# the customer waits and not how long one attempt takes. It must be shorter than
# HTTP_READ_TIMEOUT -- the tool call happens inside the turn that is waiting on it -- and
# startup fails if it is not.
ORDER_SERVICE_TIMEOUT=3s
# Total tries, not retries. Only a 5xx, a 429 or a connection that could not be made is
# retried: a 404 will still be a 404, and a timeout has already spent the budget.
ORDER_SERVICE_ATTEMPTS=2

ADMIN_TOKENS=alex:$(openssl rand -hex 24):operator,dana:$(openssl rand -hex 24)
ADMIN_TOKENS=

# The operations UI is a separate application on its own origin (admin-ui/), so the
# browser will not let it call this API unless its origin is listed here. Comma
# separated, whole origins, no trailing path. There is no wildcard: "*" here is treated
# as an origin literally named "*", which nothing is.
#   ADMIN_CORS_ORIGINS=http://localhost:5173,http://localhost:8090
ADMIN_CORS_ORIGINS=

# The operations UI (docker compose --profile ops up -d). ADMIN_API_BASE is what the
# browser will call, so it is a localhost URL even though the containers share a network.
ADMIN_UI_PORT=8090
ADMIN_API_BASE=http://localhost:8081

# --- Cost ---------------------------------------------------------------------------
# A conversation is an open-ended bill unless capped. 0 disables the cap.
CONVERSATION_TOKEN_BUDGET=200000

# --- Tracing ------------------------------------------------------------------------
# Off unless a collector is running, so `make run` on its own does not fill the log
# with failed exports. `docker compose up` turns it on.
OTLP_TRACING_EXPORT_ENABLED=false
OTLP_TRACING_ENDPOINT=http://localhost:4319
TRACING_SAMPLE_RATE=1.0
# A support question is often the most sensitive thing in a request, and traces are
# retained and read widely. On only while debugging retrieval.
TRACE_INCLUDE_QUERY_CONTENT=false
